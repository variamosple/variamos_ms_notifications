{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "extends": ["./biome.shared.jsonc"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!dist", "!coverage", "!.stryker-tmp", "!node_modules"]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "style": {
        "useImportType": "off"
      },
      "correctness": {
        "useHookAtTopLevel": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/main.ts", "src/Infrastructure/Config/env.config.ts"],
      "linter": {
        "rules": {
          "nursery": {
            "noProcessExit": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/Domain/Entities/Notification.ts",
        "src/Infrastructure/Controllers/NotificationController.ts",
        "src/Infrastructure/Modules/notification.module.ts",
        "src/UseCases/SendNotificationUseCase.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "useMaxParams": {
              "level": "info",
              "options": {
                "max": 4
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/Infrastructure/Persistence/TypeORM/Repositories/NotificationTypeORMRepository.ts"
      ],
      "linter": {
        "rules": {
          "nursery": {
            "noUnsafeTypeAssertion": "info"
          }
        }
      }
    }
  ],
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    },
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  }
}
