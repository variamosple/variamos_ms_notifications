{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "extends": ["./biome.shared.jsonc"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!dist", "!coverage", "!.stryker-tmp", "!node_modules"]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "style": {
        "useImportType": "off"
      },
      "correctness": {
        "useHookAtTopLevel": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/main.ts", "src/Infrastructure/Config/env.config.ts"],
      "linter": {
        "rules": {
          "nursery": {
            "noProcessExit": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    },
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  }
}
