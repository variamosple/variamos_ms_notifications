{
  "name": "variamos_ms_notifications",
  "version": "0.0.1",
  "description": "Real-time notification management and distribution microservice for the VariaMos platform.",
  "author": "",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "biome check --error-on-warnings . && node scripts/check-suppressions.mjs",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "stryker": "stryker run",
    "check-arch": "dependency-cruiser --config .dependency-cruiser.cjs src/",
    "typecheck": "tsc --noEmit",
    "find-deadcode": "knip",
    "spell": "cspell --no-progress --dot --gitignore \"**/*.{ts,js,cjs,mjs,json,jsonc,md,yml,yaml,sh}\" \"**/Dockerfile*\"",
    "check-updates": "taze",
    "prepare": "husky"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.2",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "@nestjs/platform-socket.io": "^12.4.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.3",
    "@nestjs/websockets": "^12.4.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.4.2",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "cspell": "^10.4.1",
    "dependency-cruiser": "^18.7.2",
    "husky": "^9.1.7",
    "knip": "^6.44.2",
    "lint-staged": "^17.6.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2",
    "taze": "^21.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "vitest-mock-extended": "^5.1.1"
  },
  "overrides": {
    "multer": "^2.5.0",
    "qs": "^6.15.3"
  }
}
